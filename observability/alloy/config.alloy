
logging {
  level  = "info"
  format = "logfmt"
}

// Discover all Docker containers.
discovery.docker "opspulse" {
  host = "unix:///var/run/docker.sock"
}

// Keep only containers belonging to OpsPulse API,
// Prometheus and Grafana.
discovery.relabel "opspulse_only" {
  targets = discovery.docker.opspulse.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "^/opspulse-(api|prometheus|grafana)-.*$"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "^/(.*)$"
    target_label  = "container_name"
  }
}

// Collect logs only from the filtered targets.
loki.source.docker "opspulse" {
  host    = "unix:///var/run/docker.sock"
  targets = discovery.relabel.opspulse_only.output

  labels = {
    project = "opspulse",
  }

  forward_to = [loki.write.local.receiver]
}


// Send collected logs to Loki.
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
